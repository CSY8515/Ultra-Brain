{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis_request.schema.json",
  "title": "Enhancement Analysis Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "objective", "metric", "records", "prediction_horizon", "options", "criteria_weights"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"const": "0.3.0"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 512},
    "metric": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "records": {
      "type": "array", "minItems": 2, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "observed_at", "source", "metrics", "quality", "consent", "dimensions"],
        "properties": {
          "id": {"type": "string"}, "observed_at": {"type": "string", "format": "date-time"},
          "source": {"type": "string", "minLength": 1, "maxLength": 256},
          "metrics": {"type": "object", "minProperties": 1, "maxProperties": 64, "additionalProperties": {"type": "number"}},
          "quality": {"type": "number", "minimum": 0, "maximum": 1},
          "consent": {"const": true},
          "dimensions": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": "string", "maxLength": 128}}
        }
      }
    },
    "prediction_horizon": {"type": "integer", "minimum": 1, "maximum": 100},
    "options": {"type": "array", "maxItems": 100},
    "criteria_weights": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "number", "minimum": 0}}
  }
}
