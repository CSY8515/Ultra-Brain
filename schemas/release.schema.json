{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/schemas/release.schema.json",
  "title": "Ultra Brain Release Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "status",
    "scope",
    "commit",
    "tag",
    "release_date",
    "validation_evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^release-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "planned",
        "candidate",
        "released",
        "withdrawn"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "release_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "validation_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
