{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/schemas/interface.schema.json",
  "title": "Ultra Brain Interface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "status",
    "owner_layer",
    "inputs",
    "outputs",
    "errors",
    "compatibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "owner_layer": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility": {
      "type": "string",
      "minLength": 1
    }
  }
}
