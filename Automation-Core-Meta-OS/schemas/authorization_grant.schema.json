{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Automation-Core-Meta-OS/schemas/authorization_grant.schema.json",
  "title": "Automation Authorization Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "approved", "safety_decision_id", "valid_from", "expires_at", "allowed_workflows", "allowed_actions", "max_steps", "max_batch_size", "allow_notifications"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "approved": {"type": "boolean"},
    "safety_decision_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "allowed_workflows": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "allowed_actions": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 64},
    "max_batch_size": {"type": "integer", "minimum": 1, "maximum": 100},
    "allow_notifications": {"type": "boolean"}
  }
}
