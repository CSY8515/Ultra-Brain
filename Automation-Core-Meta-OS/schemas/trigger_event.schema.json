{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Automation-Core-Meta-OS/schemas/trigger_event.schema.json",
  "title": "Automation Trigger Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "event_type", "occurred_at", "payload"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "event_type": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}
