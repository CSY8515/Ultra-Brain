{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Automation-Core-Meta-OS/schemas/workflow_definition.schema.json",
  "title": "Automation Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "steps", "trigger", "retry_limit"],
  "properties": {
    "id": {"$ref": "#/$defs/identifier"},
    "version": {"const": "0.4.0"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "retry_limit": {"type": "integer", "minimum": 0, "maximum": 3},
    "trigger": {"$ref": "#/$defs/trigger"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "jsonValue": {
      "oneOf": [
        {"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string"},
        {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "expected"],
      "properties": {
        "field": {"type": "string", "pattern": "^[a-zA-Z0-9_]+(?:\\.[a-zA-Z0-9_]+)*$"},
        "operator": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "contains"]},
        "expected": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event_type", "rules"],
      "properties": {
        "kind": {"enum": ["manual", "event", "schedule"]},
        "event_type": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "rules": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "needs", "parameters", "when"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "action": {"$ref": "#/$defs/identifier"},
        "needs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
        "when": {"oneOf": [{"$ref": "#/$defs/rule"}, {"type": "null"}]}
      }
    }
  }
}
