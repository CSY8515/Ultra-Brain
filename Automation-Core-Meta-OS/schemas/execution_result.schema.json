{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Automation-Core-Meta-OS/schemas/execution_result.schema.json",
  "title": "Automation Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution_id", "workflow_id", "authorization_id", "idempotency_key", "input_digest", "status", "started_at", "finished_at", "steps", "events", "notifications"],
  "properties": {
    "execution_id": {"type": "string"},
    "workflow_id": {"type": "string"},
    "authorization_id": {"type": "string"},
    "idempotency_key": {"type": "string"},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["completed", "cancelled", "compensated", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "status", "attempts", "output", "error", "compensated"],
        "properties": {
          "step_id": {"type": "string"},
          "status": {"enum": ["completed", "skipped", "cancelled", "blocked", "failed"]},
          "attempts": {"type": "integer", "minimum": 0, "maximum": 4},
          "output": {},
          "error": {"type": ["string", "null"]},
          "compensated": {"type": "boolean"}
        }
      }
    },
    "events": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "notifications": {"type": "array", "maxItems": 2, "items": {"type": "object"}}
  }
}
