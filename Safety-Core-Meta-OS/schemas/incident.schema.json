{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Safety-Core-Meta-OS/schemas/incident.schema.json",
  "title": "Safety Core Incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "severity",
    "status",
    "summary",
    "containment_block",
    "revision",
    "created_at",
    "updated_at",
    "history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "severity": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "status": {
      "enum": [
        "open",
        "contained",
        "recovering",
        "resolved",
        "closed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "containment_block": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "from_status",
          "to_status",
          "at",
          "recovery_verified"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "from_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "open",
              "contained",
              "recovering",
              "resolved",
              "closed"
            ]
          },
          "to_status": {
            "enum": [
              "open",
              "contained",
              "recovering",
              "resolved",
              "closed"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "recovery_verified": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
