{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Safety-Core-Meta-OS/schemas/backup_manifest.schema.json",
  "title": "Safety Core Backup Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "created_at",
    "algorithm",
    "files"
  ],
  "properties": {
    "version": {
      "const": "0.2.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
