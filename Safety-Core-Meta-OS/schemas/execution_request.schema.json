{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Safety-Core-Meta-OS/schemas/execution_request.schema.json",
  "title": "Safety Core Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "actor",
    "operation",
    "target",
    "permissions",
    "likelihood",
    "impact",
    "integrity_verified",
    "reversible",
    "recovery_plan_verified",
    "approved",
    "requested_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "version": {
      "const": "0.2.0"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation": {
      "enum": [
        "read",
        "validate",
        "write",
        "update",
        "backup",
        "recover",
        "release"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 100
      },
      "uniqueItems": true
    },
    "likelihood": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "impact": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "integrity_verified": {
      "type": "boolean"
    },
    "reversible": {
      "type": "boolean"
    },
    "recovery_plan_verified": {
      "type": "boolean"
    },
    "approved": {
      "type": "boolean"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
