{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Safety-Core-Meta-OS/schemas/safety_decision.schema.json",
  "title": "Safety Core Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "status",
    "reasons",
    "risk",
    "policy_version",
    "evaluated_at",
    "audit_receipt"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "status": {
      "enum": [
        "allow",
        "deny",
        "review"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 100
      },
      "uniqueItems": true
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "level",
        "likelihood",
        "impact"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "level": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        },
        "likelihood": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "impact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "policy_version": {
      "const": "0.2.0"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit_receipt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "event_id",
            "record_hash",
            "previous_hash"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "event_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 100
            },
            "record_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "previous_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  }
}
