{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Safety-Core-Meta-OS/schemas/audit_record.schema.json",
  "title": "Safety Core Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "event_id",
    "event_type",
    "timestamp",
    "data",
    "previous_hash",
    "record_hash"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^(?:0{64}|[a-f0-9]{64})$"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
