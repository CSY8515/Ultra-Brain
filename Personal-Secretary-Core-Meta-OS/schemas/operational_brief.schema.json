{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Personal-Secretary-Core-Meta-OS/schemas/operational_brief.schema.json",
  "title": "Personal Secretary Operational Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["briefing_id", "generated_at", "priority", "source_reports", "status_domains", "recommendations", "approval_requests", "outcomes", "advisory_only", "contract_version"],
  "properties": {
    "briefing_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "generated_at": {"type": "string", "format": "date-time"},
    "priority": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "source_reports": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string"}},
    "status_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ultra_brain", "core_meta_os", "registry", "validation", "release", "os_ecosystem", "project", "database"]}},
    "recommendations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["recommendation_id", "priority", "evidence_ids"],
        "properties": {
          "recommendation_id": {"type": "string"},
          "priority": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "approval_requests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["recommendation_id", "state"],
        "properties": {
          "recommendation_id": {"type": "string"},
          "state": {"enum": ["requested", "approved", "rejected", "deferred"]}
        }
      }
    },
    "outcomes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["recommendation_id", "state", "evidence_ids"],
        "properties": {
          "recommendation_id": {"type": "string"},
          "state": {"enum": ["not_requested", "pending", "completed", "failed", "recovered", "rolled_back"]},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "advisory_only": {"const": true},
    "contract_version": {"const": "0.61.0"}
  }
}
