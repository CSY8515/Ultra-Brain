{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSY8515/Ultra-Brain/Collaboration-Connectivity-Core-Meta-OS/schemas/connection_grant.schema.json",
  "title": "Connection Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "approved", "safety_decision_id", "valid_from", "expires_at", "allowed_connectors", "allowed_operations", "max_requests", "max_records", "allow_external_ai", "allow_repository_write", "allow_communication"],
  "properties": {
    "id": {"type": "string"},
    "approved": {"const": true},
    "safety_decision_id": {"type": "string", "pattern": "^decision-"},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "allowed_connectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "max_requests": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_records": {"type": "integer", "minimum": 1, "maximum": 10000},
    "allow_external_ai": {"type": "boolean"},
    "allow_repository_write": {"type": "boolean"},
    "allow_communication": {"type": "boolean"}
  }
}
